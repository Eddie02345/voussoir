#!/usr/bin/env python3
"""Drive `protonvpn signin` through a PTY without opening a terminal.

Reads the password and optional 2FA token from stdin (one line each), spawns
the CLI in a pseudo-terminal, answers its prompts, and prints the CLI output.
Exit code is the CLI's exit code (or 1 on timeout/error).
"""
import os
import pty
import re
import select
import signal
import subprocess
import sys
import time

TIMEOUT = 120


def usage() -> int:
    print("usage: protonvpn-signin-pty [--signout] USERNAME", file=sys.stderr)
    return 2


def main() -> int:
    args = sys.argv[1:]
    do_signout = False
    if args and args[0] == "--signout":
        do_signout = True
        args = args[1:]
    if len(args) != 1:
        return usage()

    username = args[0]
    lines = sys.stdin.read().splitlines()
    password = lines[0] if lines else ""
    token = lines[1] if len(lines) > 1 else ""

    if do_signout:
        try:
            result = subprocess.run(
                ["protonvpn", "signout"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=60,
                check=False,
            )
        except (OSError, subprocess.TimeoutExpired):
            print("Could not sign out the current account.", file=sys.stderr)
            return 1
        if result.returncode != 0:
            print("Could not sign out the current account.", file=sys.stderr)
            return 1

    try:
        pid, fd = pty.fork()
    except OSError as exc:
        print(f"could not start protonvpn: {exc}", file=sys.stderr)
        return 1

    if pid == 0:
        try:
            os.execvp("protonvpn", ["protonvpn", "signin", username])
        except OSError as exc:
            print(f"could not run protonvpn: {exc}", file=sys.stderr)
            os._exit(127)

    output = b""
    sent_password = False
    sent_token = False
    deadline = time.time() + TIMEOUT
    timed_out = False

    while time.time() < deadline:
        ready, _, _ = select.select([fd], [], [], 0.5)
        if not ready:
            continue
        try:
            chunk = os.read(fd, 4096)
        except OSError:
            break
        if not chunk:
            break
        output += chunk
        text = output.decode(errors="replace")
        if not sent_password and "Password:" in text:
            os.write(fd, (password + "\n").encode())
            sent_password = True
        if sent_password and not sent_token and "2FA Token:" in text:
            os.write(fd, (token + "\n").encode())
            sent_token = True

    if time.time() >= deadline:
        timed_out = True
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass

    try:
        _, status = os.waitpid(pid, 0)
        rc = os.waitstatus_to_exitcode(status)
    except ChildProcessError:
        rc = 1

    text = output.decode(errors="replace")
    text = re.sub(r"\x1b\[[0-9;]*[a-zA-Z]", "", text)
    text = text.replace("\r", "").strip()
    if text:
        print(text)
    if timed_out:
        print(f"Timed out after {TIMEOUT}s waiting for protonvpn.", file=sys.stderr)
        return 1
    return rc if isinstance(rc, int) else 1


if __name__ == "__main__":
    sys.exit(main())
